{
  "name": "homebridge-bewave-mqtt",
  "displayName": "SATEL BE WAVE - Apple HomeKit",
  "version": "1.0.8",
  "description": "BE WAVE (HYBRID) MQTT plugin voor HomeBridge",
  "main": "dist/index.js",
  "keywords": [
    "homebridge-plugin",
    "satel",
    "be wave",
    "bewave",
    "be-wave",
    "homekit",
    "apple home",
    "mqtt",
    "security system",
    "security-system",
    "abax",
    "abax2",
    "alarm",
    "smart home",
    "supports-hap"
  ],
  "license": "MIT",
  "engines": {
    "homebridge": ">=1.6.0 <3.0.0",
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "mqtt": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "homebridge": "^2.4.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsc && rm -rf dist/homebridge-ui && cp -R homebridge-ui dist/homebridge-ui && find dist/homebridge-ui -type f \\( -name \"*.bak\" -o -name \"*.bak2\" \\) -delete"
  },
  "homebridge": {
    "platforms": [
      {
        "name": "Be Wave MQTT",
        "platform": "BeWaveMQTT"
      }
    ]
  },
  "files": [
    "dist",
    "config.schema.json",
    "README.md"
  ],
  "homepage": "https://github.com/rmarobert/homebridge-bewave-mqtt",
  "bugs": {
    "url": "https://github.com/rmarobert/homebridge-bewave-mqtt/issues"
  }
}

{
  "pluginAlias": "BeWaveMQTT",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "customUiPath": "./dist/homebridge-ui",
  "headerDisplay": "Satel Be Wave MQTT integratie",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Naam",
        "type": "string",
        "default": "Be Wave MQTT"
      },
      "brokerUrl": {
        "title": "MQTT Broker URL",
        "type": "string",
        "placeholder": "mqtt://broker.local:1883"
      },
      "username": {
        "title": "MQTT gebruikersnaam",
        "type": "string"
      },
      "password": {
        "title": "MQTT wachtwoord",
        "type": "string",
        "format": "password"
      },
      "statusPrefix": {
        "title": "MQTT status topic",
        "type": "string",
        "default": "bewave/status"
      },
      "commandPrefix": {
        "title": "MQTT command topic",
        "type": "string",
        "default": "bewave/command"
      },
      "includeScenes": {
        "title": "Be Wave sc\u00e8nes gebruiken in Apple Woning",
        "type": "boolean",
        "default": false
      },
      "includeVirtualDevices": {
        "title": "Virtuele Be Wave apparaten gebruiken in Apple Woning",
        "type": "boolean",
        "default": true
      },
      "includeSecuritySystem": {
        "title": "Be Wave beveiligingsopties gebruiken in Apple Woning",
        "type": "boolean",
        "default": true
      }
    },
    "required": [
      "brokerUrl"
    ]
  }
}
